<?xml version="1.0" encoding="utf-8"?>
<!-- Adattato da app/src/main/res/layout/dialog_vehicle_onboarding.xml (richiesta esplicita
     utente 2026-08-08: stesso dialog marca/modello/motorizzazione dell'app principale, cosi'
     l'operatore sceglie dallo stesso VehicleCatalog invece di testo libero, permettendo un
     confronto esatto coi byte rilevati via VDB in dumpVehicleConfig()). Testo in inglese fisso
     (nessun R.string, coerente con lo stile del resto del probe - vedi MainActivity), non le
     due lingue IT/EN dell'app. Sezione VIN OMESSA su richiesta esplicita utente: il probe non
     fa pairing/cloud, quel concetto non si applica. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/glass_card_glow_bg"
        android:padding="28dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What car is this?"
            android:textColor="@color/on_surface"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Optional, but helps cross-check the values detected automatically below. Same catalog as the JaeDrive app."
            android:textColor="@color/on_surface_variant"
            android:textSize="15sp"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BRAND"
            android:textColor="@color/primary"
            android:textSize="14sp"
            android:letterSpacing="0.08"
            android:layout_marginBottom="10dp"/>
        <LinearLayout
            android:id="@+id/vehicle_brand_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:id="@+id/tv_vehicle_model_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MODEL"
            android:textColor="@color/primary"
            android:textSize="14sp"
            android:letterSpacing="0.08"
            android:layout_marginBottom="10dp"
            android:visibility="gone"/>
        <LinearLayout
            android:id="@+id/vehicle_model_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/tv_vehicle_powertrain_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="POWERTRAIN"
            android:textColor="@color/primary"
            android:textSize="14sp"
            android:letterSpacing="0.08"
            android:layout_marginBottom="10dp"
            android:visibility="gone"/>
        <LinearLayout
            android:id="@+id/vehicle_powertrain_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp"
            android:visibility="gone"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">
            <TextView
                android:id="@+id/btn_vehicle_onboarding_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SKIP"
                android:background="@drawable/btn_secondary_bg"
                android:textColor="@color/on_secondary_container"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingHorizontal="24dp"
                android:paddingVertical="14dp"
                android:layout_marginEnd="12dp"
                android:clickable="true"
                android:focusable="true"/>
            <TextView
                android:id="@+id/btn_vehicle_onboarding_confirm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="START SCAN"
                android:background="@drawable/btn_primary_bg"
                android:textColor="@color/on_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingHorizontal="24dp"
                android:paddingVertical="14dp"
                android:alpha="0.4"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>

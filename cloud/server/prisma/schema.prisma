// JaeDrive Cloud - Prisma schema
// Mirrors cloud/DESIGN.md §4. Table/column names kept snake_case in Postgres via @map/@@map,
// Prisma client fields stay camelCase (idiomatic on the TS side).

generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev (glibc); the musl target is what actually runs in the
  // node:20-alpine Docker image - see Dockerfile for the matching `apk add openssl`.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Mirrors a Firebase-authenticated identity. NOT the source of truth for credentials -
// Firebase is. Row is created/updated lazily on first successful token verification.
model User {
  id          String    @id @default(uuid())
  firebaseUid String    @unique @map("firebase_uid")
  email       String?
  displayName String?   @map("display_name")
  createdAt   DateTime  @default(now()) @map("created_at")
  lastLoginAt DateTime? @map("last_login_at")

  // Profile fields required by the app (see cloud/DESIGN.md and the web onboarding gate) -
  // nullable at the DB level since the row is created lazily on first token verification,
  // before the user has necessarily completed onboarding. Best-effort prefilled from the
  // Firebase ID token's name/picture claims on first login (present for Google sign-in,
  // absent for plain email/password) - see requireUser.ts.
  firstName String? @map("first_name")
  lastName  String? @map("last_name")
  photoUrl  String? @map("photo_url")

  // Accettazione di EULA/Privacy Policy, gia' incorporata nello stesso step di onboarding
  // obbligatorio (vedi RequireProfile.tsx/Onboarding.tsx) invece di un gate separato.
  // legalVersion e' la data "Ultimo aggiornamento" del testo accettato (vedi
  // cloud/web/src/legal/*.md) - un futuro cambio sostanziale dei testi fa scattare una
  // nuova accettazione bumpando CURRENT_LEGAL_VERSION lato server, che rende
  // profileComplete false finche' l'utente non riaccetta la versione aggiornata.
  legalAcceptedAt DateTime? @map("legal_accepted_at")
  legalVersion    String?   @map("legal_version")

  vehicles        Vehicle[]
  pairingsClaimed PairingRequest[]

  @@map("users")
}

// One physical car, identified by VIN, owned by one user.
model Vehicle {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vin        String   @unique
  nickname   String   @default("La mia auto")
  // Impostati dall'onboarding obbligatorio lato Android (brand->model->powertrain a
  // cascata, vedi VehicleCatalog.java), non piu' dal tentativo di rilevazione automatica
  // via VDB (ritirato - vedi jaedrive_decompiled_apks memory). `model` esisteva gia' ma
  // non era mai stato scritto da nessuna rotta; `modelYear` e' stato rimosso (stessa
  // situazione, mai popolato) a favore di `brand`/`powertrain`.
  brand      String? // "JAECOO" | "OMODA"
  model      String? // "5" | "7" | "8" | "9"
  powertrain String? // "ICE_2WD" | "ICE_4WD" | "SHS_H" | "SHS_P" | "SHS_P_4WD" | "BEV"
  createdAt  DateTime @default(now()) @map("created_at")

  devices      Device[]
  trips        Trip[]
  presetRoutes PresetRoute[]

  @@map("vehicles")
}

// Percorso ricorrente salvato dall'utente (es. "Casa-Lavoro") per aggregare in automatico i
// trip AUTO che lo percorrono - vedi jaedrive_todo #14. Creato a partire da un trip AUTO
// esistente scelto come "modello" (routes/user.ts POST .../routes): partenza/arrivo sono le
// stesse coordinate del primo/ultimo punto GPX di quel trip (vedi lib/geocode.ts
// firstAndLastPoint()), non un punto scelto su una mappa - niente UI di disegno mappa da
// costruire, e il trip "modello" stesso finira' comunque tra i risultati (e' un match di se'
// stesso). Il match con altri trip resta calcolato al volo in lib/geo.ts (haversine su
// partenza E arrivo entro radiusMeters), non precalcolato/salvato su ogni trip.
model PresetRoute {
  id           String   @id @default(uuid())
  vehicleId    String   @map("vehicle_id")
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  name         String
  startLat     Float    @map("start_lat")
  startLon     Float    @map("start_lon")
  endLat       Float    @map("end_lat")
  endLon       Float    @map("end_lon")
  radiusMeters Float    @default(150) @map("radius_meters")
  // Se true, il match (routes/user.ts GET .../routes/:routeId) controlla ANCHE la direzione
  // opposta (partenza~arrivo del percorso E arrivo~partenza del percorso), etichettando quei
  // trip "return" invece di "outbound" - richiesta esplicita utente 2026-08-02, per percorsi
  // ricorrenti fatti in entrambi i sensi (es. "Casa-Lavoro"). Di default false: un trip
  // percorso al contrario NON conta come match finche' non lo si abilita esplicitamente.
  roundTrip    Boolean  @default(false) @map("round_trip")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([vehicleId])
  @@map("preset_routes")
}

// One head-unit app install. A device belongs to at most one vehicle at a time.
model Device {
  id              String    @id @default(uuid())
  vehicleId       String?   @map("vehicle_id")
  vehicle         Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  deviceTokenHash String    @unique @map("device_token_hash")
  appVersion      String?   @map("app_version")
  lastSeenAt      DateTime? @map("last_seen_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  trips           Trip[]
  pairingRequests PairingRequest[]

  @@map("devices")
}

// Short-lived pairing session, "Netflix-style" device code flow. See DESIGN.md §7.
model PairingRequest {
  id            String   @id @default(uuid())
  code          String   @unique
  vin           String
  deviceHint    String?  @map("device_hint")
  status        String   @default("pending") // pending | claimed | expired
  deviceId      String?  @map("device_id")
  device        Device?  @relation(fields: [deviceId], references: [id])
  expiresAt     DateTime @map("expires_at")
  claimedBy     String?  @map("claimed_by")
  claimedByUser User?    @relation(fields: [claimedBy], references: [id])
  createdAt     DateTime @default(now()) @map("created_at")

  // Plaintext device token, held only transiently between claim and the car app's first
  // successful poll pickup (row expires/is cleaned up shortly after anyway - see DESIGN.md
  // §7). Nulled out once delivered so a token can never be re-read after that point, same
  // "shown once" guarantee as the permanent device_token_hash on Device.
  plaintextToken   String?   @map("plaintext_token")
  tokenDeliveredAt DateTime? @map("token_delivered_at")

  @@map("pairing_requests")
}

model Trip {
  id             String    @id @default(uuid())
  vehicleId      String    @map("vehicle_id")
  vehicle        Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  deviceId       String?   @map("device_id")
  device         Device?   @relation(fields: [deviceId], references: [id])
  // 'auto' | 'manual' - was 'auto' | 'manual_a' | 'manual_b' until 2026-07-25: a closed
  // manual trip is a single category regardless of which slot generated it (the app's own
  // Storico filter only ever distinguished AUTO vs MANUAL too), the A/B distinction lives
  // only in the free-text label. See migration 20260725210000_collapse_manual_kind for the
  // one-time data backfill of already-uploaded rows.
  kind           String
  startedAt      DateTime  @map("started_at")
  endedAt        DateTime? @map("ended_at")
  label          String?
  // Indirizzo di PARTENZA (reverse-geocoded dal primo punto GPS, come "label" lo e' per
  // l'ultimo) - calcolato lato Android da sempre ma non era mai stato incluso nel payload
  // di upload finche' non ce ne siamo accorti (2026-07-26). Nullable per lo stesso motivo
  // di "label": nessuna connessione al momento della chiusura del viaggio.
  startLabel     String?   @map("start_label")
  km             Float?
  liters         Float?
  avgConsumption Float?    @map("avg_consumption")
  pctEv          Float?    @map("pct_ev")
  pctSeries      Float?    @map("pct_series")
  pctParallel    Float?    @map("pct_parallel")
  pctOther       Float?    @map("pct_other")
  // % di tempo passato in ciascuna drive mode (ECO/NORMAL/SPORT), stesso schema di
  // pctEv/pctSeries/pctParallel/pctOther ma per ID_DRIVE_MODE invece di ID_ENERGY_FLOW -
  // vedi Android SyncWorker.computeDriveModeBreakdown(). Nullable: assente per i trip
  // caricati prima che l'app iniziasse a mandarlo, e sempre per i MANUAL (nessuna traccia).
  pctEco         Float?    @map("pct_eco")
  pctNormal      Float?    @map("pct_normal")
  pctSport       Float?    @map("pct_sport")
  // Km reali in modalita' EV/HEV, per differenza sui contatori-odometro ID_EV_MILEAGE/
  // ID_HEV_MILEAGE tra apertura e chiusura del viaggio (vedi Android TrackingService) -
  // complementare, non sostitutivo, alla stima pctEv/pctSeries/pctParallel basata sul tempo.
  kmEv           Float?    @map("km_ev")
  kmHev          Float?    @map("km_hev")
  gpxRaw         String?   @map("gpx_raw")
  createdAt      DateTime  @default(now()) @map("created_at")

  // Client-generated UUID (Android's TripDatabase, backfilled retroactively for trips that
  // predate this column) - the real idempotency key for uploads now, stronger than
  // (vehicleId, kind, startedAt) alone (e.g. survives a device DB being restored/reset and
  // re-uploading the same trips after re-pairing). Nullable + the old unique constraint
  // kept alongside it for any client that hasn't sent one yet - see routes/device.ts.
  clientUuid String? @unique @map("client_uuid")

  @@unique([vehicleId, kind, startedAt])
  @@index([vehicleId, startedAt(sort: Desc)])
  @@map("trips")
}

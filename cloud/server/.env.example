# Copy to .env for local dev (docker compose reads its own env, see cloud/.env.example)

# postgres://user:password@host:5432/dbname
DATABASE_URL=postgres://jaedrive:jaedrive@localhost:5432/jaedrive

# Port the Fastify process listens on (docker-compose maps this internally)
PORT=3000

# Firebase project id (from the Firebase console, Project settings > General)
FIREBASE_PROJECT_ID=your-firebase-project-id

# Full JSON contents of a Firebase service account key file, as a SINGLE LINE string.
# Console: Project settings > Service accounts > Generate new private key.
# Never commit the real value - this is only a placeholder shape.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# HMAC-SHA256 secret shared with the Android app's embedded (obfuscated) key - see
# CloudApiClient.java PAIRING_KEY_OBFUSCATED/PAIRING_KEY_XOR and
# src/lib/pairingAuth.ts. Must match the real value the app's constant was derived from -
# documented only in agent_log.md, never in plaintext in code.
PAIRING_HMAC_SECRET=

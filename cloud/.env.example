# Copy to .env next to docker-compose.yml (docker compose reads .env automatically).

POSTGRES_PASSWORD=change-me

FIREBASE_PROJECT_ID=your-firebase-project-id
# Full JSON of a Firebase service-account key, as ONE LINE. Console: Project settings >
# Service accounts > Generate new private key.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Firebase *web app* config (public, safe to expose client-side) - Console: Project
# settings > General > Your apps > Web app > SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

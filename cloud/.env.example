# Copy to .env next to docker-compose.yml (docker compose reads .env automatically).

POSTGRES_PASSWORD=change-me

FIREBASE_PROJECT_ID=your-firebase-project-id
# Full JSON of a Firebase service-account key, as ONE LINE. Console: Project settings >
# Service accounts > Generate new private key.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Firebase *web app* config (public, safe to expose client-side) - Console: Project
# settings > General > Your apps > Web app > SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Email di amministrazione (separate da virgola per piu' admin)
ADMIN_EMAILS=tuaemail@esempio.com

# Chiave API Resend per invio email (opzionale)
RESEND_API_KEY=re_123456789

# Chiave HMAC-SHA256 condivisa con la stessa costante offuscata in
# app/src/main/java/com/phabryc/jaedrive/CloudApiClient.java (PAIRING_KEY_OBFUSCATED +
# PAIRING_KEY_XOR) - firma POST /api/device/pairing/start, vedi
# cloud/server/src/lib/pairingAuth.ts. Deve combaciare esattamente col valore reale usato
# per generare quella costante (documentato solo in agent_log.md, mai in chiaro nel codice).
PAIRING_HMAC_SECRET=


<?xml version="1.0" encoding="utf-8"?>
<!-- Geist Mono (variable font, SIL OFL) - font "accattivante" per i dati numerici
     (velocita', statistiche viaggio, ecc.), come previsto dal design originale
     Aetheris Automotive ("Monospacing: Geist e' usato per i dati tecnici"). -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/geist_mono_variable"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/geist_mono_variable"
        app:fontStyle="normal"
        app:fontWeight="400"
        app:fontVariationSettings="'wght' 400" />
    <font
        android:font="@font/geist_mono_variable"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/geist_mono_variable"
        app:fontStyle="normal"
        app:fontWeight="700"
        app:fontVariationSettings="'wght' 700" />
</font-family>

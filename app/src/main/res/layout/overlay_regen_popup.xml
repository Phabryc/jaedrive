<?xml version="1.0" encoding="utf-8"?>
<!-- Popup dedicato al cambio livello rigenerazione (vedi OverlayPopup.showRegenLevel()) -
     layout diverso dal popup generico (overlay_popup.xml): logo in alto a sinistra accanto
     al titolo, valore su una riga a parte sotto, piu' grande - richiesto esplicitamente
     dall'utente dopo aver visto la prima versione (centrata, testo unico) sul campo. Logo
     ingrandito e valore centrato su richiesta successiva (2026-08-02: il logo a 40dp era
     "una macchia", irriconoscibile). Raddoppiato di nuovo lo stesso giorno (64dp ancora
     poco visibile). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/glass_card_glow_bg"
    android:padding="28dp"
    android:minWidth="320dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:layout_width="128dp"
            android:layout_height="128dp"
            android:layout_marginEnd="14dp"
            android:src="@drawable/jd_logo"
            android:contentDescription="@null"/>
        <TextView
            android:id="@+id/tv_regen_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/overlay_regen_title"
            android:textColor="@color/on_surface_variant"
            android:textSize="20sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_regen_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textColor="@color/on_surface"
        android:textSize="44sp"
        android:textStyle="bold"/>
</LinearLayout>

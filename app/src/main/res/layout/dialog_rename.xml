<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog di rinomina di uno slot trip manuale, in stile app (card scura) invece del
     dialog di sistema chiaro/di default - con tasti di preset predefiniti (traducibili,
     vedi array preset_trip_names) oltre al campo libero. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/glass_card_glow_bg"
    android:padding="28dp">

    <TextView
        android:id="@+id/tv_rename_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/on_surface"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="18dp"/>

    <EditText
        android:id="@+id/et_rename_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_bg"
        android:textColor="@color/on_surface"
        android:textColorHint="@color/on_surface_variant"
        android:textSize="20sp"
        android:padding="16dp"
        android:singleLine="true"
        android:maxLines="1"
        android:layout_marginBottom="18dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_rename_presets"
        android:textColor="@color/primary"
        android:textSize="14sp"
        android:letterSpacing="0.08"
        android:layout_marginBottom="10dp"/>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="24dp">
        <LinearLayout
            android:id="@+id/preset_chip_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"/>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">
        <TextView
            android:id="@+id/btn_rename_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_btn_cancel"
            android:background="@drawable/btn_secondary_bg"
            android:textColor="@color/on_secondary_container"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingHorizontal="24dp"
            android:paddingVertical="14dp"
            android:layout_marginEnd="12dp"
            android:clickable="true"
            android:focusable="true"/>
        <TextView
            android:id="@+id/btn_rename_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_btn_save"
            android:background="@drawable/btn_primary_bg"
            android:textColor="@color/on_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingHorizontal="24dp"
            android:paddingVertical="14dp"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>
</LinearLayout>

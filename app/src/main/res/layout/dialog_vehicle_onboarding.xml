<?xml version="1.0" encoding="utf-8"?>
<!-- Onboarding marca/modello/motorizzazione - obbligatorio al primo avvio (non annullabile,
     bottone CHIUDI nascosto), riapribile in seguito per modificare la scelta (annullabile,
     bottone CHIUDI visibile) toccando la card "Veicolo" in Impostazioni. Tre righe di chip a
     cascata (stesso stile "segmento selezionato" gia' usato per il toggle AUTO/MANUALE dello
     Storico) invece di spinner/dropdown di sistema, coerente con il resto dell'app. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/glass_card_glow_bg"
        android:padding="28dp">

        <TextView
            android:id="@+id/tv_vehicle_onboarding_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dialog_vehicle_onboarding_title"
            android:textColor="@color/on_surface"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dialog_vehicle_onboarding_message"
            android:textColor="@color/on_surface_variant"
            android:textSize="15sp"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_vehicle_brand"
            android:textColor="@color/primary"
            android:textSize="14sp"
            android:letterSpacing="0.08"
            android:layout_marginBottom="10dp"/>
        <LinearLayout
            android:id="@+id/vehicle_brand_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:id="@+id/tv_vehicle_model_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_vehicle_model"
            android:textColor="@color/primary"
            android:textSize="14sp"
            android:letterSpacing="0.08"
            android:layout_marginBottom="10dp"
            android:visibility="gone"/>
        <LinearLayout
            android:id="@+id/vehicle_model_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/tv_vehicle_powertrain_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_vehicle_powertrain"
            android:textColor="@color/primary"
            android:textSize="14sp"
            android:letterSpacing="0.08"
            android:layout_marginBottom="10dp"
            android:visibility="gone"/>
        <LinearLayout
            android:id="@+id/vehicle_powertrain_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp"
            android:visibility="gone"/>

        <!-- VIN (system property "sys.vehicle.hardware.vin.code", con fallback su
             Settings.Global "ivi.sn" - S/N del DMC, non un VIN vero - sui modelli/SW che non
             espongono la property: vedi MainActivity.tryReadRealVin()/refreshVinFromCar()) -
             sempre visibile, anche nel primo onboarding obbligatorio (li' mostra solo il
             valore gia' rilevato, in sola lettura: il pulsante RILEVA VIN/GET VIN compare
             solo se l'auto e' gia' associata al cloud, quando serve correggere un valore
             gia' inviato in passato). L'etichetta sopra il valore (tv_vehicle_vin_onboarding_
             label) cambia dinamicamente tra "VIN" e "S/N DMC" secondo quale fonte ha
             risposto - vedi MainActivity.updateVinLabel(). -->
        <LinearLayout
            android:id="@+id/vehicle_vin_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/tv_vehicle_vin_onboarding_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_vehicle_vin"
                android:textColor="@color/primary"
                android:textSize="14sp"
                android:letterSpacing="0.08"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_vehicle_vin_onboarding"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_vehicle_vin_unknown"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="15sp"
                    android:layout_marginEnd="12dp"/>

                <TextView
                    android:id="@+id/btn_vehicle_vin_refresh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_vehicle_vin_refresh"
                    android:background="@drawable/btn_secondary_bg"
                    android:textColor="@color/on_secondary_container"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="10dp"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">
            <TextView
                android:id="@+id/btn_vehicle_onboarding_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dialog_btn_close"
                android:background="@drawable/btn_secondary_bg"
                android:textColor="@color/on_secondary_container"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingHorizontal="24dp"
                android:paddingVertical="14dp"
                android:layout_marginEnd="12dp"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone"/>
            <TextView
                android:id="@+id/btn_vehicle_onboarding_confirm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dialog_btn_confirm"
                android:background="@drawable/btn_primary_bg"
                android:textColor="@color/on_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingHorizontal="24dp"
                android:paddingVertical="14dp"
                android:alpha="0.4"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
